{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Library Management System",
            "type": "shell",
            "windows": {
                "command": "${workspaceFolder}\\build.bat"
            },
            "linux": {
                "command": "${workspaceFolder}/build.sh"
            },
            "osx": {
                "command": "${workspaceFolder}/build.sh"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Library Management System",
            "type": "shell",
            "windows": {
                "command": "${workspaceFolder}\\run.bat"
            },
            "linux": {
                "command": "${workspaceFolder}/library"
            },
            "osx": {
                "command": "${workspaceFolder}/library"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build Library Management System",
            "problemMatcher": []
        }
    ]
}
